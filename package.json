{
  "name": "dbx-mail",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "description": "DBX 邮件：本地优先的多账户邮件工作台",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "backend:dev": "cargo build --manifest-path backend/Cargo.toml",
    "backend": "cargo build --release --manifest-path backend/Cargo.toml",
    "sidecar-check": "node scripts/sidecar-check.mjs",
    "sanitize-check": "node scripts/sanitize-check.mjs",
    "pack": "node scripts/package.mjs",
    "pack:cli": "dbx-plugin package . --output-dir release"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@dbx-app/plugin-cli": "^0.1.9",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
